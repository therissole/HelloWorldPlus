<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>c117fac1-2668-4161-a76a-cff0e160ebfa</UserSecretsId>
    <!-- Aspire's SDK resolves native dashboard and orchestration packages per host OS. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Blazor" Version="13.4.6-preview.1.26319.6" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.4.6" />
    <PackageReference Include="Aspire.Hosting.Keycloak" Version="13.4.6-preview.1.26319.6" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    <!-- Pin the patched transitive dependency until Aspire updates StreamJsonRpc. -->
    <PackageReference Include="MessagePack" Version="2.5.303" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HelloWorldPlus.Api\HelloWorldPlus.Api.csproj" />
    <ProjectReference Include="..\HelloWorldPlus.DatabaseMigrations\HelloWorldPlus.DatabaseMigrations.csproj" />
    <ProjectReference Include="..\HelloWorldPlus.OpenFgaProvisioning\HelloWorldPlus.OpenFgaProvisioning.csproj" />
    <ProjectReference Include="..\HelloWorldPlus.Gateway\HelloWorldPlus.Gateway.csproj" />
    <ProjectReference Include="..\HelloWorldPlus.Web\HelloWorldPlus.Web.csproj" />
  </ItemGroup>

</Project>
