<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HelloWorldPlus.OpenFgaProvisioning</AssemblyName>
    <RootNamespace>HelloWorldPlus.OpenFgaProvisioning</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HelloWorldPlus.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenFga.Sdk" Version="0.10.4" />
    <PackageReference Include="Npgsql" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\openfga\authorization-model.json"
          Link="OpenFga\authorization-model.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
