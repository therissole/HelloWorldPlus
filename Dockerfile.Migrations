FROM mcr.microsoft.com/dotnet/sdk:10.0.302 AS build
WORKDIR /src

COPY ["global.json", "."]
COPY ["Directory.Build.props", "."]
COPY ["BannedSymbols.txt", "."]
COPY [".editorconfig", "."]
COPY ["src/HelloWorldPlus.DatabaseMigrations/HelloWorldPlus.DatabaseMigrations.csproj", "src/HelloWorldPlus.DatabaseMigrations/"]
COPY ["src/HelloWorldPlus.DatabaseMigrations/packages.lock.json", "src/HelloWorldPlus.DatabaseMigrations/"]
RUN dotnet restore "src/HelloWorldPlus.DatabaseMigrations/HelloWorldPlus.DatabaseMigrations.csproj" --locked-mode

COPY . .
WORKDIR "/src/src/HelloWorldPlus.DatabaseMigrations"
RUN dotnet publish "HelloWorldPlus.DatabaseMigrations.csproj" -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/runtime:10.0.10 AS final
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "HelloWorldPlus.DatabaseMigrations.dll"]
