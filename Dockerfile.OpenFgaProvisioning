FROM mcr.microsoft.com/dotnet/sdk:10.0.302 AS build
WORKDIR /src

COPY ["global.json", "."]
COPY ["Directory.Build.props", "."]
COPY ["BannedSymbols.txt", "."]
COPY [".editorconfig", "."]
COPY ["src/HelloWorldPlus.OpenFgaProvisioning/HelloWorldPlus.OpenFgaProvisioning.csproj", "src/HelloWorldPlus.OpenFgaProvisioning/"]
COPY ["src/HelloWorldPlus.OpenFgaProvisioning/packages.lock.json", "src/HelloWorldPlus.OpenFgaProvisioning/"]
RUN dotnet restore "src/HelloWorldPlus.OpenFgaProvisioning/HelloWorldPlus.OpenFgaProvisioning.csproj" --locked-mode

COPY . .
WORKDIR "/src/src/HelloWorldPlus.OpenFgaProvisioning"
RUN dotnet publish "HelloWorldPlus.OpenFgaProvisioning.csproj" -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/runtime:10.0.10 AS final
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "HelloWorldPlus.OpenFgaProvisioning.dll"]
